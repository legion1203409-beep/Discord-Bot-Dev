# Copy to .env.local and fill the values on your Windows PC.
# Never commit .env.local or paste its contents into chat.
# DATABASE_URL can be copied from the intended Replit database's connection details.
DATABASE_URL=
DISCORD_TOKEN=

# Optional: needed for Oracle AI replies and other AI features.
OPENAI_API_KEY=

# Keep privileged intents disabled unless you intentionally use them.
DISCORD_PRIVILEGED_INTENTS_ENABLED=false
ORACLE_MESSAGE_CONTENT_ENABLED=false
