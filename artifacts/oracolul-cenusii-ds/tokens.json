{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f3eee6" },
      "foreground": { "$value": "#1b1e23" },
      "border": { "$value": "#d8cec0" },
      "card": { "$value": "#fffaf2" },
      "cardForeground": { "$value": "#1b1e23" },
      "popover": { "$value": "#fffaf2" },
      "popoverForeground": { "$value": "#1b1e23" },
      "primary": {
        "$value": "#8d3929",
        "$description": "Derived light-mode counterpart of the ember brand color."
      },
      "primaryForeground": { "$value": "#fffaf2" },
      "secondary": { "$value": "#e8e1d7" },
      "secondaryForeground": { "$value": "#272722" },
      "muted": { "$value": "#e8e1d7" },
      "mutedForeground": { "$value": "#645f59" },
      "accent": { "$value": "#eadfc8" },
      "accentForeground": { "$value": "#302719" },
      "destructive": { "$value": "#a83f36" },
      "destructiveForeground": { "$value": "#fffaf2" },
      "input": { "$value": "#d8cec0" },
      "ring": { "$value": "#8d3929" },
      "chart1": { "$value": "#a94431" },
      "chart2": { "$value": "#8d7043" },
      "chart3": { "$value": "#786b8d" },
      "chart4": { "$value": "#527b89" },
      "chart5": { "$value": "#4e805f" },
      "sidebar": { "$value": "#e8e1d7" },
      "sidebarForeground": { "$value": "#272722" },
      "sidebarBorder": { "$value": "#d8cec0" },
      "sidebarPrimary": { "$value": "#8d3929" },
      "sidebarPrimaryForeground": { "$value": "#fffaf2" },
      "sidebarAccent": { "$value": "#ddd3c5" },
      "sidebarAccentForeground": { "$value": "#272722" },
      "sidebarRing": { "$value": "#8d3929" }
    },
    "dark": {
      "background": { "$value": "#101114" },
      "foreground": { "$value": "#f3eee6" },
      "border": { "$value": "#35373b" },
      "card": { "$value": "#1b1e23" },
      "cardForeground": { "$value": "#f3eee6" },
      "popover": { "$value": "#24282e" },
      "popoverForeground": { "$value": "#f3eee6" },
      "primary": { "$value": "#d66a4d" },
      "primaryForeground": { "$value": "#181512" },
      "secondary": { "$value": "#24282e" },
      "secondaryForeground": { "$value": "#f3eee6" },
      "muted": { "$value": "#24282e" },
      "mutedForeground": { "$value": "#c9c2b8" },
      "accent": { "$value": "#b8945f" },
      "accentForeground": { "$value": "#181512" },
      "destructive": { "$value": "#d66a5f" },
      "destructiveForeground": { "$value": "#181512" },
      "input": { "$value": "#303237" },
      "ring": { "$value": "#d66a4d" },
      "chart1": { "$value": "#d66a4d" },
      "chart2": { "$value": "#e0bc7f" },
      "chart3": { "$value": "#9b89ae" },
      "chart4": { "$value": "#83a8b7" },
      "chart5": { "$value": "#78bb8e" },
      "sidebar": { "$value": "#15171b" },
      "sidebarForeground": { "$value": "#f3eee6" },
      "sidebarBorder": { "$value": "#292c31" },
      "sidebarPrimary": { "$value": "#d66a4d" },
      "sidebarPrimaryForeground": { "$value": "#181512" },
      "sidebarAccent": { "$value": "#24282e" },
      "sidebarAccentForeground": { "$value": "#f3eee6" },
      "sidebarRing": { "$value": "#d66a4d" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["DM Sans", "sans-serif"],
        "$description": "Source Status UI and body typeface."
      },
      "serif": {
        "$value": ["Cormorant Garamond", "Georgia", "serif"],
        "$description": "Editorial display face used by the public Status site."
      },
      "mono": {
        "$value": ["DM Mono", "monospace"],
        "$description": "Compact metadata and technical labels used by Status."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
